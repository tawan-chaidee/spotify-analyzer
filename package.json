{
  "name": "spotify-analyzer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:mock": "npm run dev:demo",
    "dev:mock-auth": "vite --mode mock-auth",
    "mock:art": "node scripts/generate-mock-art.mjs",
    "mock:fixture": "node scripts/generate-mock-fixture.mjs && npm run mock:art",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:demo": "svelte-check --tsconfig ./tsconfig.json && vite build --mode demo",
    "build:mock": "npm run build:demo",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && vite build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
}
